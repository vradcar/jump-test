# =============================================================================
# LinkedIn Profile Finder - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.

# AI Provider: "groq" (free, recommended) | "gemini" (free) | "openai" (paid)
AI_PROVIDER=groq

# Groq API Key (free — get yours at https://console.groq.com/keys)
# Free tier: 30 requests/min, 14,400 requests/day
GROQ_API_KEY=

# Groq Model (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (only needed if AI_PROVIDER=gemini)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Model (optional, defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Key (only needed if AI_PROVIDER=openai)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Email enrichment method (default: auto)
# "auto"   = free pattern guess + SMTP first, Hunter.io fallback (RECOMMENDED)
# "guess"  = free pattern guess + SMTP only — no API key needed, unlimited
# "hunter" = Hunter.io API only (requires HUNTER_API_KEY)
EMAIL_METHOD=auto

# Hunter.io API Key (OPTIONAL — only needed if EMAIL_METHOD=hunter or auto)
# Get yours at: https://hunter.io/api-keys — 25 free lookups/month
# Leave blank to use the free pattern guesser only
HUNTER_API_KEY=

# Google Search Cookie (required for scraping)
# Instructions:
# 1. Open Google.com in Chrome (logged in to a Google account)
# 2. Open DevTools (F12) → Network tab
# 3. Search for anything on Google
# 4. Click the first request to google.com
# 5. Copy the entire "Cookie" header value
GOOGLE_COOKIE=your-google-cookie-here

# Google Search User-Agent (optional - auto-detected if empty)
# Copy your User-Agent from DevTools → Network → Request Headers
GOOGLE_USER_AGENT=

# Number of Google results to fetch per search (default: 10)
GOOGLE_NUM_RESULTS=10

# Rate limit delay between Google requests in seconds (default: 3)
GOOGLE_DELAY_SECONDS=3

# Output format: csv, json, or both (default: both)
OUTPUT_FORMAT=both

# Output directory (default: ./output)
OUTPUT_DIR=./output
