# =============================================================================
# LinkedIn Profile Finder - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.

# OpenAI API Key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Hunter.io API Key (required for email enrichment)
# Get yours at: https://hunter.io/api-keys
HUNTER_API_KEY=your-hunter-api-key-here

# Google Search Cookie (required for scraping)
# Instructions:
# 1. Open Google.com in Chrome (logged in to a Google account)
# 2. Open DevTools (F12) → Network tab
# 3. Search for anything on Google
# 4. Click the first request to google.com
# 5. Copy the entire "Cookie" header value
GOOGLE_COOKIE=your-google-cookie-here

# Google Search User-Agent (optional - auto-detected if empty)
# Copy your User-Agent from DevTools → Network → Request Headers
GOOGLE_USER_AGENT=

# Number of Google results to fetch per search (default: 10)
GOOGLE_NUM_RESULTS=10

# Rate limit delay between Google requests in seconds (default: 3)
GOOGLE_DELAY_SECONDS=3

# Output format: csv, json, or both (default: both)
OUTPUT_FORMAT=both

# Output directory (default: ./output)
OUTPUT_DIR=./output
